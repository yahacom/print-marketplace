# systemd unit for stl-upload (SAD §7: single long-lived process on one VM).
# The same process also serves quote-engine and order-confirmation (their
# in-process stl-upload calls require co-location, ADR-0002/0008), so this one
# unit is the order-confirmation deployment too.
# quote-engine and order-confirmation need FIRESTORE_CREDENTIALS_JSON (the
# service-account JSON itself, not a path). Supply it from a root-only file via
# EnvironmentFile= or a drop-in; never put the value in this unit.
# Install: /etc/systemd/system/stl-upload.service, then
#   systemctl daemon-reload && systemctl enable --now stl-upload
# Assumes the built app (`npm ci --omit=dev && npm run build`) lives in
# /opt/stl-upload and that the `stl-upload` user exists.
# quote-engine (T4) shells out to the PrusaSlicer CLI; pinned version: 2.9.6
# (verified against real files). Install it so `prusa-slicer` is on PATH, or set
# PRUSA_SLICER_BIN. Re-verify docs/features/quote-engine/tasks/T4-* if bumped.
[Unit]
Description=stl-upload service
After=network.target

[Service]
Type=simple
User=stl-upload
WorkingDirectory=/opt/stl-upload
Environment=NODE_ENV=production
Environment=PORT=3000
# ADR-0003: uploads live on the local disk; quote-engine must read the same path.
Environment=STORAGE_DIR=/var/lib/stl-upload/models
ExecStart=/usr/bin/node dist/main.js

# Restart on crash (DoD), with a short delay to avoid a hot loop.
Restart=always
RestartSec=2

# Directory is created and owned by the service user; nothing else is writable.
StateDirectory=stl-upload
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
