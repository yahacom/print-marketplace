{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "sonnet",
    "effortLevel": "medium",
    "permissions": {
        "deny": [
            "Read(**/*firebase-adminsdk*.json)",
            "Edit(**/*firebase-adminsdk*.json)",
            "Bash(git reset --hard*)",
            "Bash(git push --force*)",
            "Bash(git push -f*)"
        ]
    },
    "sandbox": {
        "filesystem": {
            "denyRead": ["**/*firebase-adminsdk*.json"]
        }
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Read|Edit|Write|Bash|Grep|Glob",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/log-credential-access.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/block-secret-commit.sh"
                    }
                ]
            }
        ]
    }
}